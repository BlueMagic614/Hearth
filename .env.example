# Copy to .env and fill in for production.
# DATABASE_URL=postgres://hearth:password@localhost:5432/hearth
# PORT=8787
# NODE_ENV=production
# Bank sync (Phase 2). Keys come from dashboard.plaid.com → Developers → Keys.
# HEARTH_ENCRYPTION_KEY=any-long-random-string
# PLAID_CLIENT_ID=
# PLAID_SECRET_SANDBOX=
# PLAID_SECRET_PRODUCTION=   # once set, Hearth uses Plaid production (real Kemba) automatically
# PLAID_ENV=sandbox          # optional override
# PLAID_ALLOW_REFRESH=true   # optional: "Sync now" also asks Kemba for new activity (billed by Plaid)
# Categorization agent (Phase 3). Optional: without it, new payees go to the review list.
# ANTHROPIC_API_KEY=
# HEARTH_AGENT_MODEL=claude-haiku-5-5
